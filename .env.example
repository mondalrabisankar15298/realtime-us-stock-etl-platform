# ==========================================
# Real-Time Stock ETL Platform - Environment Variables
# ==========================================
# Copy this file to .env and modify as needed
# cp .env.example .env

# ==========================================
# Redpanda/Kafka Configuration
# ==========================================
REDPANDA_BROKER=redpanda:9092
KAFKA_TOPIC_RAW=stock-raw-data
KAFKA_TOPIC_DLQ=stock-dlq

# ==========================================
# Spark Configuration
# ==========================================
SPARK_MASTER=spark://spark-master:7077
SPARK_WORKER_CORES=2
SPARK_WORKER_MEMORY=2g
SPARK_DRIVER_MEMORY=1g
SPARK_EXECUTOR_MEMORY=2g

# ==========================================
# Delta Lake Paths
# ==========================================
DELTA_PATH_BRONZE=/opt/spark/delta_tables/bronze
DELTA_PATH_SILVER=/opt/spark/delta_tables/silver
DELTA_PATH_GOLD=/opt/spark/delta_tables/gold
CHECKPOINT_PATH_BRONZE=/opt/spark/checkpoints/bronze
CHECKPOINT_PATH_SILVER=/opt/spark/checkpoints/silver
CHECKPOINT_PATH_GOLD=/opt/spark/checkpoints/gold

# ==========================================
# Airflow Configuration
# ==========================================
AIRFLOW_UID=50000
AIRFLOW_GID=0
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow:airflow@postgres-airflow/airflow
AIRFLOW__CORE__FERNET_KEY=46BKJoQYlPPOexq0OhDZnIlNepKFf87WFwLbfzqDDho=
AIRFLOW__CORE__DAGS_ARE_PAUSED_AT_CREATION=true
AIRFLOW__CORE__LOAD_EXAMPLES=false
AIRFLOW__API__AUTH_BACKENDS=airflow.api.auth.backend.basic_auth,airflow.api.auth.backend.session
AIRFLOW__WEBSERVER__SECRET_KEY=secret

# ==========================================
# Grafana Configuration
# ==========================================
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin
GF_INSTALL_PLUGINS=grafana-clock-panel

# ==========================================
# PostgreSQL/TimescaleDB Configuration
# ==========================================
POSTGRES_GRAFANA_USER=grafana
POSTGRES_GRAFANA_PASSWORD=grafana
POSTGRES_GRAFANA_DB=stockdata

# ==========================================
# Stock Tickers Configuration
# ==========================================
# Comma-separated list of stock ticker symbols
STOCK_TICKERS=AAPL,MSFT,GOOGL,AMZN,NVDA,META,TSLA,NFLX,AMD,AVGO

# ==========================================
# Producer Configuration
# ==========================================
# Interval between data fetches (in seconds)
PRODUCER_INTERVAL_SECONDS=60
# Maximum retry attempts for failed fetches
PRODUCER_MAX_RETRIES=3
# Initial retry delay in seconds (exponential backoff)
PRODUCER_RETRY_DELAY=5

# ==========================================
# Timezone Configuration
# ==========================================
# Set to your local timezone or America/New_York for US market hours
TZ=America/New_York

# ==========================================
# Notes
# ==========================================
# - All ports are in the 7000-7999 range to avoid conflicts
# - Default values work out of the box
# - Modify STOCK_TICKERS to track different stocks
# - Adjust PRODUCER_INTERVAL_SECONDS to change fetch frequency
# - Change TZ to match your timezone

# ==========================================
# ETL Mode Selection
# ==========================================
# Choose between Spark-based or Polars-based ETL processing
# Possible values: "spark" | "polars"
# - spark:  Uses Apache Spark for distributed processing (higher memory usage, ~4GB)
# - polars: Uses Polars for lightweight processing (lower memory usage, ~500MB)
# Both modes write to the same Delta Lake tables and TimescaleDB tables
# You can switch between modes by changing this value and restarting containers
COMPOSE_PROFILES=polars

# ==========================================
# Backfill Configuration
# ==========================================
# Number of days to backfill when starting fresh (default: 30)
BACKFILL_DAYS=30

# Force a complete data cleanup and re-backfill on next startup
# Possible values: true | false
# WARNING: Setting to "true" will DELETE ALL existing data including:
#   - Kafka topics
#   - Delta Lake tables (Bronze, Silver, Gold)
#   - Polars checkpoints
#   - Spark checkpoints
#   - TimescaleDB data
#   - Producer state
#   - Airflow metadata
# Use this when you want a completely fresh start
FORCE_BACKFILL=false
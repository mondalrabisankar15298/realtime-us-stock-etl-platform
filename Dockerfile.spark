FROM apache/spark:3.4.1

USER root

# Install additional dependencies
RUN apt-get update && apt-get install -y \
    curl \
    wget \
    && rm -rf /var/lib/apt/lists/*

# Verify existing Spark JARs are present
RUN ls -la /opt/spark/jars/ | head -5 || echo "Warning: JARs directory check"

# Download Delta Lake and Kafka dependencies (add to existing JARs)
RUN cd /opt/spark/jars && \
    wget -q https://repo1.maven.org/maven2/io/delta/delta-core_2.12/2.4.0/delta-core_2.12-2.4.0.jar && \
    wget -q https://repo1.maven.org/maven2/io/delta/delta-storage/2.4.0/delta-storage-2.4.0.jar && \
    wget -q https://repo1.maven.org/maven2/org/apache/spark/spark-sql-kafka-0-10_2.12/3.4.1/spark-sql-kafka-0-10_2.12-3.4.1.jar && \
    wget -q https://repo1.maven.org/maven2/org/apache/spark/spark-token-provider-kafka-0-10_2.12/3.4.1/spark-token-provider-kafka-0-10_2.12-3.4.1.jar && \
    wget -q https://repo1.maven.org/maven2/org/apache/kafka/kafka-clients/3.4.0/kafka-clients-3.4.0.jar && \
    wget -q https://repo1.maven.org/maven2/org/apache/commons/commons-pool2/2.11.1/commons-pool2-2.11.1.jar && \
    chown -R spark:spark /opt/spark/jars

# Install Python dependencies for Spark jobs
RUN pip install --no-cache-dir \
    delta-spark==2.4.0 \
    pyspark==3.4.1 \
    kafka-python==2.0.2

# Create directories
RUN mkdir -p /opt/spark/delta_tables /opt/spark/checkpoints /opt/spark-jobs && \
    chown -R spark:spark /opt/spark/delta_tables /opt/spark/checkpoints /opt/spark-jobs

# Create Ivy cache directory for Spark user
RUN mkdir -p /home/spark/.ivy2/cache && \
    chown -R spark:spark /home/spark/.ivy2

USER spark

WORKDIR /opt/spark-jobs

